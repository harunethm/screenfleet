#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// First icon resource = the exe's icon in Explorer (made by tools/make-icons.mjs).
1 ICON "sst.ico"

IDR_FONT_REGULAR RCDATA "../../assets/fonts/Geist-Regular.ttf"
IDR_FONT_MEDIUM  RCDATA "../../assets/fonts/Geist-Medium.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ScreenFleet"
            VALUE "ProductName", "ScreenFleet"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "ScreenFleet.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
